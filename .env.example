# LUMINARK CodeWriter API configuration

# Required for authenticated endpoints. Generate a random secret of 32+ characters.
CODEWRITER_API_KEY=

# Development only. Optional; disabled in ENVIRONMENT=production.
CODEWRITER_DEMO_KEY=

# Use development for local trusted testing. Production requires Docker mode.
ENVIRONMENT=development
LUMINARK_MODE=docker
LUMINARK_DOCKER_IMAGE=luminark-sandbox:latest
LUMINARK_MAX_ITERATIONS=3
LUMINARK_STABILITY_THRESHOLD=3.0

# Development browser origin. Production requires explicit HTTPS origins.
CORS_ORIGINS=http://localhost:3000

# Internal Redis service URL; set appropriate credentials/TLS for deployments.
REDIS_URL=redis://redis:6379
